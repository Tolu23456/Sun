import { Nav } from "./components/Nav.sun";

page Home "/" {
  render {
    <div .sun-app>
      <Nav />
      <div .sun-hero>
        <h1>Pure Sun SPA</h1>
        <p>No HTML, No CSS, Just Sun.</p>
      </div>

      <div .sun-footer>
        <span .sun-badge>modular architecture</span>
      </div>
    </div>
  }
}

page Counter "/counter" {
  state count = 0

  render {
    <div .sun-app>
      <Nav />
      <h2>Modular Counter</h2>
      <div .count-display>{count}</div>
      <div .btn-row>
        <button .btn .btn-danger @click={count--}>-</button>
        <button .btn .btn-primary @click={count++}>+</button>
      </div>
    </div>
  }
}

page About "/about" {
  render {
    <div .sun-app>
      <Nav />
      <h2>About Pure Sun</h2>
      <p .sun-card>Every component is a .sun file with integrated logic and styling.</p>
    </div>
  }
}

mount(Home, "#app");
