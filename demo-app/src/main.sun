// Sun 5.0 Universal GUI Showcase
import { Nav } from "./components/Nav.sun";

component Sidebar {
  style {
    .sidebar { width: 200px; border-right: 1px solid #333; }
  }
  render {
    <div .sidebar>
      <h3>System Info</h3>
      <p>OS: Linux</p>
      <p>GPU: Supported</p>
    </div>
  }
}

page Home "/" {
  render {
    <div .sun-app>
      <Nav />
      <div .layout-row>
        <Sidebar />
        <div .main-content>
          <h1>Sun 5.0 High-Performance GUI</h1>
          <p>This UI is running on the Sun VM with optional GPU acceleration.</p>
        </div>
      </div>
    </div>
  }
}

mount(Home, "#app");
