// Sun 2.0 Showcase
// Demonstrating compactness and reactivity.

component App {
  state count = 0
  state title = "Sun 2.0"

  fn increment() => count++

  fn decrement() {
    if (count > 0) count--
  }

  render {
    <div .sun-app>
      <div .sun-hero>
        <h1>Welcome to {title}</h1>
        <p>Compact, Fast, Easy.</p>
      </div>

      <div .sun-counter>
        <div .count-display>{count}</div>
        <div .btn-row>
          <button .btn .btn-danger @click={count--}>-</button>
          <button .btn .btn-secondary @click={count = 0}>Reset</button>
          <button .btn .btn-primary @click={increment}>+</button>
        </div>
      </div>

      <div .sun-footer>
        <span .sun-badge>built with sun 2.0</span>
      </div>
    </div>
  }
}

mount(App, "#app");
