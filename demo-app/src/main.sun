// Sun 2.0 Multi-page SPA Showcase

page Home "/" {
  render {
    <div .sun-app>
      <div .sun-hero>
        <h1>Welcome to Sun SPA</h1>
        <p>Ultra-fast navigation between pages.</p>
      </div>

      <div .sun-cards>
        <button .btn .btn-primary @click={Sun.navigate("/counter")}>Go to Counter</button>
        <button .btn .btn-secondary @click={Sun.navigate("/about")}>About Sun</button>
      </div>

      <div .sun-footer>
        <span .sun-badge>home page</span>
      </div>
    </div>
  }
}

page Counter "/counter" {
  state count = 0

  render {
    <div .sun-app>
      <h2>Interactive Counter</h2>
      <div .count-display>{count}</div>
      <div .btn-row>
        <button .btn .btn-danger @click={count--}>-</button>
        <button .btn .btn-primary @click={count++}>+</button>
      </div>
      <button .btn .btn-secondary @click={Sun.navigate("/")}>Back Home</button>
    </div>
  }
}

page About "/about" {
  render {
    <div .sun-app>
      <h2>About Sun</h2>
      <p .sun-card>Sun is a cross-platform language for Web, Android, iOS, and Linux.</p>
      <button .btn .btn-secondary @click={Sun.navigate("/")}>Back Home</button>
    </div>
  }
}

mount(Home, "#app");
